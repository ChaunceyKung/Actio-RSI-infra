{
  "case": "lifecycle",
  "tests": [
    {
      "test_id": "P1-lifecycle",
      "status": "PASS",
      "assertions": [
        "cold handshake, native events, same-session multi-turn, distinct sessions, two concurrent homes, Chinese/space paths",
        "provider inputs prove cross-home and cross-session marker isolation",
        "only read-only fixture tool enumerated"
      ],
      "barrier": {
        "kind": "native-barrier",
        "session": "same",
        "through": 11,
        "seam": "sessionPersistence.flush"
      }
    },
    {
      "test_id": "P1-shared-context",
      "status": "PASS",
      "assertions": [
        "same session retains A_SECRET; other session excludes it"
      ]
    },
    {
      "test_id": "P1-restart",
      "status": "PASS",
      "behavior": {
        "outcome": "rejected",
        "error": "session \"same\" already exists"
      },
      "unchanged_journals": true,
      "assertions": [
        "reusing persisted session ID is characterized, not assumed to resume"
      ]
    }
  ],
