# Copy this file to .env and fill in your own values.
# Do NOT commit the real .env (it is gitignored).

# Main model endpoint for the original examples/* harness scripts.
# ToMEval-aligned evaluation reads the main model from ToMEval/experiment_config.yaml.
TOM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Your API key for the endpoint
TOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model name on that endpoint
TOM_MODEL=qwen3-32b

# Sampling temperature (0.0 = deterministic, higher = more creative)
TOM_TEMPERATURE=0.0

# ── Helper endpoint credentials (selector / category classifier) ────
# Optional endpoint credentials for memory selector and RAG category classifier.
# The helper route uses the same model name as the evaluated model.
HELPER_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
HELPER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
